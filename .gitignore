# build26-repo-template

Template files will not be tracked by git.
*.bak
*.tmp

# Source materials folder — contents excluded, README tracked
_remove-before-publish/*
!_remove-before-publish/README.md

# OS files
.DS_Store
Thumbs.db

# IDE files (except .vscode/mcp.json which we want)
.idea/
*.swp
*.swo

# Environment files with secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/

# Build output
dist/
*.tsbuildinfo

# Rayfin temp/generated files
**/rayfin/.temp/
**/rayfin/.deployments.json

# Keys and certs
keys/
*.pem

# Additional env patterns
.env.fabric
.env.fabric-*
.env.template
.env.production
